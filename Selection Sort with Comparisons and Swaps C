#include <stdio.h>

int main() {
    int n, i, j, min, temp, a[100];
    int comp = 0, swaps = 0;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 0; i < n - 1; i++) {
        min = i;
        for(j = i + 1; j < n; j++) {
            comp++;
            if(a[j] < a[min])
                min = j;
        }

        if(min != i) {
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
            swaps++;
        }
    }

    printf("Sorted Array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nComparisons: %d", comp);
    printf("\nSwaps: %d", swaps);

    return 0;
}
