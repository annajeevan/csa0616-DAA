#include <stdio.h>

int main() {
    int n, i, j, temp, a[100];
    int passes = 0;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 0; i < n - 1; i++) {
        passes++;

        for(j = 0; j < n - i - 1; j++) {
            if(a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
    }

    printf("Sorted Array:\n");

    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nNumber of Passes: %d", passes);

    return 0;
}
